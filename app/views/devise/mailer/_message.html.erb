<% paragraphs = Array(paragraphs) %>
<% notes = Array(local_assigns[:notes]) %>
<% action_url = local_assigns[:action_url] %>
<% action_label = local_assigns[:action_label] %>
<% preview = paragraphs.join(" ").squish.truncate(180) %>
<div style="display:none;font-size:1px;color:#f4f4f5;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;"><%= preview %></div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;background-color:#f4f4f5;margin:0;padding:0;">
  <tr>
    <td align="center" style="padding:28px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;max-width:560px;background-color:#ffffff;border:1px solid #e4e4e7;border-radius:16px;overflow:hidden;">
        <tr>
          <td align="left" style="background-color:#000000;padding:28px 28px 24px;text-align:left;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
              <tr>
                <td valign="middle" width="52" style="width:52px;text-align:left;">
                  <img src="<%= attachments['forge-mark.png'].url %>" width="40" height="40" alt="<%= t("user.mailer.product") %>" style="display:block;width:40px;height:40px;border:0;border-radius:10px;">
                </td>
                <td valign="middle" align="left" style="padding-left:12px;text-align:left;">
                  <div style="font-size:13px;line-height:1.3;color:#a1a1aa;"><%= t("user.mailer.product") %></div>
                  <div style="margin-top:2px;font-size:16px;line-height:1.35;font-weight:600;color:#fafafa;"><%= eyebrow %></div>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td align="left" style="padding:28px 28px 8px;text-align:left;">
            <% paragraphs.each do |paragraph| %>
              <p style="margin:0 0 16px;font-size:16px;line-height:1.5;color:#18181b;"><%= paragraph %></p>
            <% end %>
            <% if action_url.present? %>
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:8px 0 20px;">
                <tr>
                  <td bgcolor="#059669" style="border-radius:10px;background-color:#059669;">
                    <a href="<%= action_url %>" style="display:inline-block;padding:12px 18px;font-size:14px;line-height:1.2;font-weight:600;color:#ffffff;text-decoration:none;"><%= action_label %></a>
                  </td>
                </tr>
              </table>
            <% end %>
            <% notes.each do |note| %>
              <p style="margin:0 0 16px;font-size:13px;line-height:1.5;color:#71717a;"><%= note %></p>
            <% end %>
          </td>
        </tr>
        <tr>
          <td align="left" style="padding:4px 28px 22px;text-align:left;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
              <tr>
                <td valign="top" width="26" style="width:26px;">
                  <img src="<%= attachments['forge-mark.png'].url %>" width="18" height="18" alt="" style="display:block;width:18px;height:18px;border:0;border-radius:4px;">
                </td>
                <td valign="top" style="padding-left:8px;font-size:12px;line-height:1.45;color:#71717a;">
                  <div><%= t("user.mailer.footer") %></div>
                  <div style="margin-top:2px;"><%= t("user.mailer.copyright", year: Time.current.year) %></div>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
